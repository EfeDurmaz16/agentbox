{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.dev/schemas/agentpod-evidence-bundle.schema.json",
  "title": "AgentPod Evidence Bundle Index",
  "description": "Canonical v0 index.json schema for an AgentPod evidence bundle directory. The index inventories bundle files and declares compatibility; validators must also verify file hashes and JSONL event chains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "bundle_id",
    "session_id",
    "created_at",
    "producer",
    "compatibility",
    "required_file_kinds",
    "files",
    "root_hash"
  ],
  "properties": {
    "schema": {
      "const": "agentpod-evidence-bundle"
    },
    "schema_version": {
      "const": 0
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_reader_version",
        "forward_compatible"
      ],
      "properties": {
        "min_reader_version": {
          "type": "string",
          "minLength": 1
        },
        "forward_compatible": {
          "type": "boolean"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "required_file_kinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileKind"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "session"
          }
        },
        {
          "contains": {
            "const": "manifest"
          }
        },
        {
          "contains": {
            "const": "provider_receipt"
          }
        },
        {
          "contains": {
            "const": "policy_decisions"
          }
        },
        {
          "contains": {
            "const": "approvals"
          }
        },
        {
          "contains": {
            "const": "commands"
          }
        },
        {
          "contains": {
            "const": "artifacts"
          }
        },
        {
          "contains": {
            "const": "hashes"
          }
        },
        {
          "contains": {
            "const": "redactions"
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/fileDescriptor"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "session"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "manifest"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "provider_receipt"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "policy_decisions"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "approvals"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "commands"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "artifacts"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "hashes"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "redactions"
              }
            }
          }
        }
      ]
    },
    "root_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value",
        "covers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "encoding": {
          "const": "hex"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "covers": {
          "const": "files[] descriptors excluding index.json"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileKind": {
      "enum": [
        "session",
        "manifest",
        "provider_receipt",
        "policy_decisions",
        "approvals",
        "commands",
        "artifacts",
        "hashes",
        "redactions",
        "replay",
        "integrations",
        "transcript",
        "network",
        "filesystem",
        "credentials"
      ]
    },
    "mediaType": {
      "enum": [
        "application/json",
        "application/jsonl"
      ]
    },
    "redactionBoundary": {
      "enum": [
        "none",
        "redacted",
        "tokenized",
        "descriptor-only",
        "omitted"
      ]
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "media_type",
        "required",
        "bytes",
        "sha256",
        "redaction_boundary"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\).+"
        },
        "kind": {
          "$ref": "#/$defs/fileKind"
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "required": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redaction_boundary": {
          "$ref": "#/$defs/redactionBoundary"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
